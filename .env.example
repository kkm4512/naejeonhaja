# 이 파일을 .env 로 복사한 뒤 값을 채워 주세요.  (Windows: copy .env.example .env)
# .env 는 비밀값이므로 git 에 올리거나 다른 사람에게 보내지 마세요.

# Riot 개발자 포털(https://developer.riotgames.com)에서 발급한 키
# 개발용 키는 24시간마다 만료됩니다. 새로 발급받아 바꾼 뒤 `docker compose up -d` 를 다시 실행하세요.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# (선택) DB 비밀번호. 처음 실행하기 전에 정하세요 (나중에 바꾸면 기존 DB 에 접속하지 못합니다)
DB_PASSWORD=naejeonhaja

# (선택) 접속 포트
FRONTEND_PORT=3000
BACKEND_PORT=8080

# (선택) Riot 호출 한도 "횟수:초" — 운영(Production) 키를 받으면 크게 올리세요. 예: 450:10,27000:600
RIOT_RATE_LIMITS=18:1,95:120

# (선택) 부 라인 / 라인 외 배정 시 MMR 감점 (세부 티어 1단계 = 50)
LOL_SUB_LINE_PENALTY=100
LOL_OFF_ROLE_PENALTY=250

# (선택) 라인 자동 설정: 이번 시즌 랭크 최근 N판의 모스트 3 챔피언으로 정함
#   N 을 줄이면 검색이 빨라지고(개발용 키 기준 10명 20판 ≈ 4~5분, 10판 ≈ 2~3분), 늘리면 정확해집니다.
LOL_INSIGHT_SAMPLE=20
#   이번 시즌 시작일 (비우면 올해 1월 1일)
LOL_SEASON_START=

# (선택) 방 입장 토큰 서명 키. 비우면 처음 실행할 때 자동으로 만들어 DB 에 저장합니다.
APP_SECRET=

# (선택) Data Dragon 재로드 API(POST /api/v1/game/lol/dataDragon/reload) 용 토큰. 비우면 비활성화
APP_ADMIN_TOKEN=
